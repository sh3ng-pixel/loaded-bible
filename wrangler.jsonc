{
  "name": "loadmybible",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Your progress is stored here (created automatically on deploy, free plan friendly)
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  // keep the secrets you add in the Cloudflare dashboard when the site updates
  "keep_vars": true
}
